# Core model profile: medical_quality | balanced | ultra_light
MODEL_PROFILE=medical_quality

# Ollama inside Docker Compose. For native backend use http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=medgemma1.5:4b
LLM_FALLBACK_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Best medical retrieval profile
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=NeuML/pubmedbert-base-embeddings
RERANKER_MODEL=ncbi/MedCPT-Cross-Encoder
RERANKER_FALLBACK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
ENABLE_RERANKER=true

# Retrieval and context
CHUNK_SIZE=1100
CHUNK_OVERLAP=160
DENSE_K=24
LEXICAL_K=24
RERANK_K=14
FINAL_K=8
MAX_CONTEXT_CHARS=18000
MAX_UPLOAD_MB=80
MAX_FILES_PER_SESSION=12

# Generation
PLANNER_MODE=auto
OLLAMA_TIMEOUT_SECONDS=300
TEMPERATURE=0.12
MAX_OUTPUT_TOKENS=1600

# Runtime
DATA_DIR=/app/data
HF_HOME=/models/huggingface
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:8501
RAG_API_URL=http://backend:8000

# Add this only when running the optional Cloudflare service
CLOUDFLARE_TUNNEL_TOKEN=
